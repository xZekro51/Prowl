<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>8600;8601;8618;8602;8603;8604;8625;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Editor.Tests" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../Build/Editor/Debug/</OutputPath>
    <DefineConstants>$(DefineConstants);PROWL_PROFILING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>../Build/Editor/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prowl.Runtime\Prowl.Runtime.csproj" />
    <ProjectReference Include="..\Prowl.ImGui\Prowl.ImGui.csproj" />
    <ProjectReference Include="..\Prowl.EventSystem.Generators\Prowl.EventSystem.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
    <PackageReference Include="ImGui.NET" Version="1.90.8.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.Maui.Core" Version="10.0.50" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\Resources\*.png" />
    <EmbeddedResource Include="Icons\Resources\*.ttf" />
  </ItemGroup>

  <!-- Copy the source generator DLL to the output so that the editor can
       reference it at runtime for IDE solution generation and Roslyn script
       compilation.  Placed in an 'analyzers' subfolder to keep it out of
       the regular engine-reference scan. -->
  <Target Name="CopyEventSystemGeneratorToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_EventGenDll Condition="Exists('$(MSBuildThisFileDirectory)..\Prowl.EventSystem.Generators\bin\$(Configuration)\netstandard2.0\Prowl.EventSystem.Generators.dll')">$(MSBuildThisFileDirectory)..\Prowl.EventSystem.Generators\bin\$(Configuration)\netstandard2.0\Prowl.EventSystem.Generators.dll</_EventGenDll>
    </PropertyGroup>
    <MakeDir Directories="$(TargetDir)analyzers" Condition="'$(_EventGenDll)' != ''" />
    <Copy SourceFiles="$(_EventGenDll)" DestinationFolder="$(TargetDir)analyzers" SkipUnchangedFiles="true" Condition="'$(_EventGenDll)' != ''" />
  </Target>

</Project>
